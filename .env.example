# docker compose 용 설정. 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 처리됨)
# 애플리케이션 자체 설정은 MyPickCafe_AI/.env.example 을 참고하세요.
# 여기 값은 compose 가 컨테이너에 환경변수로 주입하며, 이미지 안의 기본값을 덮어씁니다.

# ── PostgreSQL ────────────────────────────────────────────────────────
# 기존 mypickcafe_pgdata 볼륨에 이미 데이터가 있다면, 그때 쓰던 값과 같아야 접속됩니다.
POSTGRES_DB=mypickcafe
POSTGRES_USER=mypickcafe
POSTGRES_PASSWORD=

# ── LLM (OpenAI 호환, 원격) ───────────────────────────────────────────
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_API_KEY=
LLM_MODEL=accounts/fireworks/models/glm-5p3-flash
LLM_TIMEOUT=60

# ── 임베딩 (compose 의 ollama 컨테이너에서 서빙) ──────────────────────
# 주소는 compose 가 http://ollama:11434 로 고정해 넣습니다.
EMBED_MODEL=bge-m3

# ── Spring Boot (mypickcafe-web) ──────────────────────────────────────
# DB 주소와 FastAPI 주소는 compose 가 서비스 이름으로 고정해 넣습니다
# (jdbc:postgresql://postgres:5432/..., http://mypickcafe-ai:8000).
#
# JwtTokenProvider 가 Base64 로 디코딩하므로 Base64 문자열이어야 합니다(HS256, 디코딩 후 32바이트 이상).
#   생성 예: openssl rand -base64 48
JWT_SECRET=

# 지도 탐색 페이지용. 비워 두면 지도만 동작하지 않습니다.
KAKAO_JS_KEY=
KAKAO_REST_KEY=

# dev(기본): ddl-auto=update, Swagger 켜짐 / prod: ddl-auto=validate, CORS_ALLOWED_ORIGINS 필수
SPRING_PROFILES_ACTIVE=dev
# prod 프로파일에서만 쓰입니다. 쉼표로 구분 (예: https://mypickcafe.com)
CORS_ALLOWED_ORIGINS=

# 호스트에서 열 포트.
WEB_PORT=8080
# 힙 비율 등 JVM 옵션을 직접 지정하고 싶을 때만 채우세요.
SPRING_JAVA_OPTS=

# ── 컨테이너 메모리 한도 ──────────────────────────────────────────────
# t3.large(8GB) 기준 배분입니다. 상시 4개 합계 6.5GB, 나머지 1.5GB 는 OS·페이지 캐시.
#   web 1GB + ai 2GB + postgres 1GB + ollama 2.5GB = 6.5GB
# 메모리가 더 큰 개발 PC라면 그대로 둬도 되고, 넉넉히 올려도 됩니다.
# OLLAMA 를 너무 낮게 잡으면 임베딩 모델을 올리다 컨테이너가 OOM 으로 죽습니다.
WEB_MEM_LIMIT=1g          # Spring Boot (JVM 힙은 이 값의 70%)
AI_MEM_LIMIT=2g           # 통합 FastAPI + ChromaDB 인덱스
POSTGRES_MEM_LIMIT=1g
OLLAMA_MEM_LIMIT=2.5g     # 임베딩 모델(bge-m3)
# 아래 둘은 상시 실행이 아니라 위 합계에 넣지 않았습니다.
OLLAMA_INIT_MEM_LIMIT=512m  # 기동 시 모델 내려받기만 하고 끝나는 일회성 컨테이너
CHROMA_SERVER_MEM_LIMIT=1g  # chroma-server 프로필을 쓸 때만
