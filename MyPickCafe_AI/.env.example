# MyPickCafe_AI 공통 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 처리됨)
#
# 실행 위치와 무관하게 이 파일(MyPickCafe_AI/.env) 하나만 읽습니다.
# PickBot_AI/ · Review_Tag_AI/ · Create_Dummy/ 어디에서 띄우든 동일하게 적용됩니다.

# ── LLM (OpenAI 호환 /chat/completions) ──────────────────────────────
# base_url 은 "/chat/completions" 바로 앞까지 적습니다. 보통 /v1 으로 끝납니다.
#   로컬 Ollama 호환 레이어 : http://127.0.0.1:11434/v1
#   (localhost 로 쓰면 Windows 에서 새 연결마다 약 2.2s 지연이 붙습니다)
#   배포한 모델 서버        : https://<your-llm-host>/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1

# 인증이 없는 서버라면 비워두세요. (빈 값이면 Bearer 헤더를 서버가 무시합니다)
LLM_API_KEY=

# LLM 모델 이름 — LLM_BASE_URL 이 가리키는 서버 기준으로 적습니다.
#   로컬 Ollama : qwen2.5:14b
#   Fireworks   : accounts/fireworks/models/glm-5p3-flash  (2026-09 실측 비교로 선정)
LLM_MODEL=qwen2.5:14b
LLM_TIMEOUT=60

# ── 임베딩 (Ollama 네이티브 /api/embed) ───────────────────────────────
# LLM 과 다른 서버를 가리킬 수 있습니다. /v1 을 붙이지 마세요.
# PickBot_AI(RAG) 에서만 사용합니다. Review_Tag_AI 는 임베딩을 쓰지 않습니다.
EMBED_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# 검색 쿼리처럼 적은 양의 임베딩을 CPU 로 돌립니다. 로컬에서 LLM 과 GPU 를 나눠 쓸 때
# 요청마다 모델을 교체하는 지연(수 초)을 없앱니다. LLM 이 원격인 배포 환경은 false 가능.
EMBED_SMALL_BATCHES_ON_CPU=true

# ── PostgreSQL (PickBot_AI RAG 인덱싱용) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mypickcafe
DB_USER=mypickcafe
DB_PASSWORD=

# ── ChromaDB ─────────────────────────────────────────────────────────
# 상대경로는 실행 위치가 아니라 MyPickCafe_AI/ 기준으로 풀립니다.
# embed_all.py(PickBot_AI/)와 app.py(MyPickCafe_AI/)가 같은 인덱스를 씁니다.
CHROMA_PATH=./chroma_db
