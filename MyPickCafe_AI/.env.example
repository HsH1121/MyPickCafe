# MyPickCafe_AI 공통 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 처리됨)
#
# 실행 위치와 무관하게 이 파일(MyPickCafe_AI/.env) 하나만 읽습니다.
# ChatBot_AI/ · Review_Tag_AI/ · Create_Dummy/ 어디에서 띄우든 동일하게 적용됩니다.

# ── LLM (OpenAI 호환 /chat/completions) ──────────────────────────────
# base_url 은 "/chat/completions" 바로 앞까지 적습니다. 보통 /v1 으로 끝납니다.
#   로컬 Ollama 호환 레이어 : http://localhost:11434/v1
#   배포한 모델 서버        : https://<your-llm-host>/v1
LLM_BASE_URL=http://localhost:11434/v1

# 인증이 없는 서버라면 비워두세요. (빈 값이면 Bearer 헤더를 서버가 무시합니다)
LLM_API_KEY=

OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=60

# ── 임베딩 (Ollama 네이티브 /api/embed) ───────────────────────────────
# LLM 과 다른 서버를 가리킬 수 있습니다. /v1 을 붙이지 마세요.
# ChatBot_AI(RAG) 에서만 사용합니다. Review_Tag_AI 는 임베딩을 쓰지 않습니다.
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# ── PostgreSQL (ChatBot_AI RAG 인덱싱용) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mypickcafe
DB_USER=mypickcafe
DB_PASSWORD=

# ── ChromaDB ─────────────────────────────────────────────────────────
# 상대경로는 실행 위치가 아니라 MyPickCafe_AI/ 기준으로 풀립니다.
# embed_all.py(ChatBot_AI/)와 app.py(MyPickCafe_AI/)가 같은 인덱스를 씁니다.
CHROMA_PATH=./chroma_db
