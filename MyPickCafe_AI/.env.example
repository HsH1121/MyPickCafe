# MyPickCafe_AI 공통 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 처리됨)
#
# 실행 위치와 무관하게 이 파일(MyPickCafe_AI/.env) 하나만 읽습니다.
# PickBot_AI/ · Review_Tag_AI/ · Create_Dummy/ 어디에서 띄우든 동일하게 적용됩니다.

# ── LLM (OpenAI 호환 /chat/completions) ──────────────────────────────
# 픽봇·리뷰 태그는 로컬에서도 배포와 같은 Fireworks glm-5p3-flash 를 씁니다(코드 기본값).
# 키만 넣으면 됩니다. 더미 생성(Create_Dummy)은 이 설정을 쓰지 않고 로컬 Ollama qwen2.5:14b 로 고정입니다.
LLM_API_KEY=

# 다른 서버·모델로 바꿀 때만 적습니다. base_url 은 "/chat/completions" 바로 앞까지, 보통 /v1 으로 끝납니다.
#   Fireworks (기본값)    : https://api.fireworks.ai/inference/v1  /  accounts/fireworks/models/glm-5p3-flash
#   로컬 Ollama          : http://127.0.0.1:11434/v1  /  qwen2.5:14b  (이때 LLM_REASONING_EFFORT 는 빈 값)
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_MODEL=accounts/fireworks/models/glm-5p3-flash
LLM_TIMEOUT=60
# 픽봇 1차 호출(질문 분해)의 타임아웃(초). 넘으면 한 번 더 시도하고, 그래도 실패하면 지역 필터 없이 진행합니다.
LLM_PARSE_TIMEOUT=5
# 지역 맵에 없는 표현을 LLM 에 물을 때의 타임아웃(초).
LLM_REGION_TIMEOUT=10
# 지역 확인 호출의 추론량. 생략하면 medium. 비추론 모델(qwen2.5)로 바꾸면 빈 값으로 두세요.
# LLM_REGION_REASONING_EFFORT=medium

# 픽봇 1차·판정 호출의 추론량. 생략하면 low(glm-5p3-flash 에 필요).
# 비추론 모델(qwen2.5)로 바꾸면 빈 값으로 두세요. 값을 보내면 Ollama 가 400 "does not support thinking" 을 반환합니다.
# LLM_REASONING_EFFORT=low

# ── 임베딩 (Ollama 네이티브 /api/embed) ───────────────────────────────
# LLM 과 다른 서버를 가리킬 수 있습니다. /v1 을 붙이지 마세요.
# PickBot_AI(RAG) 에서만 사용합니다. Review_Tag_AI 는 임베딩을 쓰지 않습니다.
EMBED_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# 검색 쿼리처럼 적은 양의 임베딩을 CPU 로 돌립니다. 로컬에서 LLM 과 GPU 를 나눠 쓸 때
# 요청마다 모델을 교체하는 지연(수 초)을 없앱니다. LLM 이 원격인 배포 환경은 false 가능.
EMBED_SMALL_BATCHES_ON_CPU=true

# ── PostgreSQL (PickBot_AI RAG 인덱싱용) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mypickcafe
DB_USER=mypickcafe
DB_PASSWORD=

# ── ChromaDB ─────────────────────────────────────────────────────────
# 상대경로는 실행 위치가 아니라 MyPickCafe_AI/ 기준으로 풀립니다.
# embed_all.py(PickBot_AI/)와 app.py(MyPickCafe_AI/)가 같은 인덱스를 씁니다.
CHROMA_PATH=./chroma_db

# ── 개발 환경 전용 ───────────────────────────────────────────────────
# 픽봇 추천 요청마다 단계별 걸린 시간·결과를 PickBot_AI/logs/pickbot_trace.log 와 콘솔에 남깁니다.
# 배포 환경(루트 .env / compose)에는 넣지 마세요. 기본값은 꺼짐입니다.
PICKBOT_TRACE=true
