# Copy this file to "secret.properties" in the same directory and fill in real values.
# secret.properties is git-ignored and must never be committed.
#
#   cp secret.properties.example secret.properties
#
# Every key below can also be supplied as an environment variable instead,
# which is how the prod profile is expected to run.

# ---- Database ----
DB_USERNAME=mypickcafe
DB_PASSWORD=change-me

# ---- JWT ----
# HS256 requires at least 256 bits (32+ characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Kakao Maps (optional; map features degrade without them) ----
KAKAO_JS_KEY=
KAKAO_REST_KEY=
