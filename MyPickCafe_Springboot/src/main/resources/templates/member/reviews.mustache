{{>layout/header}}

<main class="cg-container">
  <div class="cg-mypage-grid">

    <aside>
      <nav class="cg-sidenav">
        <a href="/member/me">내 정보</a>
        <a href="/member/edit">정보 수정</a>
        <a href="/member/reviews" class="is-active">내가 쓴 리뷰</a>
        <a href="/favorites">즐겨찾기</a>
        <div class="cg-sidenav__divider"></div>
        <a href="/member/withdraw" class="is-danger">회원 탈퇴</a>
      </nav>
    </aside>

    <section>
      <div class="cg-panel">
        <div class="cg-panel__head">
          <div>
            <p class="cg-eyebrow">내 활동</p>
            <h2 class="cg-panel__title">내가 쓴 리뷰</h2>
          </div>
          <span class="cg-badge cg-badge--accent">총 {{totalElements}}개</span>
        </div>

        <div class="cg-panel__body">

          {{#hasContent}}
            <div style="display:flex;flex-direction:column;gap:12px">
              {{#items}}
                <div class="cg-card" style="display:grid;grid-template-columns:88px 1fr;gap:16px;align-items:start;overflow:visible">
                  {{#cafePhotoUrl}}
                    <img src="{{cafePhotoUrl}}" alt="썸네일"
                         style="width:88px;height:88px;object-fit:cover;border-radius:var(--r-sm);border:1px solid var(--line)"
                         loading="lazy"/>
                  {{/cafePhotoUrl}}
                  {{^cafePhotoUrl}}
                    <div style="width:88px;height:88px;border-radius:var(--r-sm);
                                border:1px dashed var(--line-strong);background:var(--bg-alt);
                                display:flex;align-items:center;justify-content:center;
                                font-size:11px;color:var(--text-muted)">NO IMG</div>
                  {{/cafePhotoUrl}}
                  <div class="cg-card__body" style="padding:12px 14px 12px 0">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px">
                      <a href="/cafes/{{cafeId}}" class="cg-link" style="font-size:15px;font-weight:700">{{cafeName}}</a>
                      <time class="cg-muted">{{reviewDateFmt}}</time>
                    </div>
                    <p style="font-size:13px;line-height:1.6;color:var(--text-sub);margin-bottom:10px">{{excerpt}}</p>
                    <div class="cg-actions">
                      <a href="/cafes/{{cafeId}}" class="cg-btn cg-btn--sm">카페 보기</a>
                    </div>
                  </div>
                </div>
              {{/items}}
            </div>

            <nav class="cg-pagination">
              {{#hasPrev}}<a href="?page={{prevPage}}">이전</a>{{/hasPrev}}
              {{#pages}}
                <a href="?page={{index}}" class="{{#active}}is-active{{/active}}">{{display}}</a>
              {{/pages}}
              {{#hasNext}}<a href="?page={{nextPage}}">다음</a>{{/hasNext}}
            </nav>
          {{/hasContent}}

          {{^hasContent}}
            <div class="cg-empty" style="padding:48px 20px">
              <p style="margin-bottom:16px">아직 작성한 리뷰가 없어요.</p>
              <a class="cg-btn" href="/">카페 찾으러 가기</a>
            </div>
          {{/hasContent}}

        </div>
      </div>
    </section>

  </div>
</main>

{{>layout/footer}}
