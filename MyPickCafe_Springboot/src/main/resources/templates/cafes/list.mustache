{{>layout/header}}

<main class="cg-container" style="padding-top:32px;padding-bottom:64px">

  <!-- 페이지 헤더 -->
  <div style="margin-bottom:28px">
    <p class="cg-eyebrow">카페 탐색</p>
    <h1 style="font-size:26px;font-weight:900;letter-spacing:-.5px">전체 카페</h1>
  </div>

  <!-- 탭 -->
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px;border-bottom:2px solid var(--line);padding-bottom:0">
    <a href="{{urlSortLikes}}"
       style="padding:10px 18px;font-size:14px;font-weight:600;border-radius:var(--r-sm) var(--r-sm) 0 0;text-decoration:none;transition:all var(--t);
              {{#sortLikes}}background:var(--accent);color:#fff;{{/sortLikes}}
              {{^sortLikes}}color:var(--text-sub);{{/sortLikes}}">
      좋아요 비율
    </a>
    <a href="{{urlSortNewest}}"
       style="padding:10px 18px;font-size:14px;font-weight:600;border-radius:var(--r-sm) var(--r-sm) 0 0;text-decoration:none;transition:all var(--t);
              {{#sortNewest}}background:var(--accent);color:#fff;{{/sortNewest}}
              {{^sortNewest}}color:var(--text-sub);{{/sortNewest}}">
      최근 등록
    </a>
    <a href="{{urlSortRecommend}}"
       style="padding:10px 18px;font-size:14px;font-weight:600;border-radius:var(--r-sm) var(--r-sm) 0 0;text-decoration:none;transition:all var(--t);
              {{#sortRecommend}}background:var(--accent);color:#fff;{{/sortRecommend}}
              {{^sortRecommend}}color:var(--text-sub);{{/sortRecommend}}">
      맞춤 추천
    </a>
    <a href="{{urlSortTags}}"
       style="padding:10px 18px;font-size:14px;font-weight:600;border-radius:var(--r-sm) var(--r-sm) 0 0;text-decoration:none;transition:all var(--t);
              {{#sortTags}}background:var(--accent);color:#fff;{{/sortTags}}
              {{^sortTags}}color:var(--text-sub);{{/sortTags}}">
      태그 필터링
    </a>
    <button id="tabPickBot"
       style="padding:10px 18px;font-size:14px;font-weight:600;border-radius:var(--r-sm) var(--r-sm) 0 0;
              border:none;cursor:pointer;transition:all var(--t);background:none;color:var(--text-sub)">
      픽봇
    </button>
  </div>

  <!-- 안내 메시지 + 태그 필터 + 카페 목록 -->
  <div id="mainContent">

    {{#needsLogin}}
      <div class="cg-flash" style="margin-bottom:20px">
        맞춤 추천은 로그인 후 이용할 수 있어요.
        <a href="/login" class="cg-link" style="margin-left:8px">로그인하기 →</a>
      </div>
    {{/needsLogin}}
    {{#noNeedsSet}}
      <div class="cg-flash" style="margin-bottom:20px">
        설정된 니즈가 없어요. 마이페이지에서 니즈를 선택하면 맞춤 카페를 추천해드려요.
        <a href="/member/me" class="cg-link" style="margin-left:8px">니즈 설정하기 →</a>
      </div>
    {{/noNeedsSet}}

    <!-- 태그 필터 -->
    {{#sortTags}}
    <div id="tagFilters" style="margin-bottom:28px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <span style="font-size:13px;font-weight:700;color:var(--text-sub)">태그 필터 — 선택한 태그를 모두 가진 카페</span>
        {{#hasTagFilter}}
          <a href="{{urlClearTag}}" class="cg-btn-outline cg-btn--sm">전체 보기 ×</a>
        {{/hasTagFilter}}
      </div>
      {{#tagGroups}}
        <div style="margin-bottom:10px">
          <span style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-right:8px">
            {{categoryLabel}}
          </span>
          <span class="cg-chips" style="display:inline-flex;flex-wrap:wrap;gap:6px">
            {{#tags}}
              <a href="{{href}}"
                 aria-pressed="{{active}}" role="button"
                 class="cg-chip {{#active}}is-active{{/active}}"
                 style="text-decoration:none">{{label}}</a>
            {{/tags}}
          </span>
        </div>
      {{/tagGroups}}
    </div>

    {{/sortTags}}

    <!-- 카페 목록 -->
    {{#isEmpty}}
      <div class="cg-empty">
        <p>조건에 맞는 카페가 없습니다.</p>
      </div>
    {{/isEmpty}}

    {{^isEmpty}}
      <ul class="cg-card-grid" style="list-style:none;padding:0;margin:0">
        {{#cafes}}
          <li class="cg-card cg-cafe-card">
            <a class="cg-card__link" href="/cafes/{{id}}">
              <div class="cg-card__imgwrap">
                <img class="cg-card__img" src="{{mainPhoto}}" alt="{{name}}"
                     onerror="this.style.display='none';this.parentElement.classList.add('cg-noimg')"/>
                <span class="cg-card__views-badge">조회 {{views}}</span>
              </div>
              <div class="cg-card__body-inner">
                <p class="cg-card__title">{{name}}</p>
                <p class="cg-card__addr">📍 {{address}}</p>
              </div>
            </a>
          </li>
        {{/cafes}}
      </ul>
    {{/isEmpty}}

  </div><!-- /#mainContent -->

  <!-- 픽봇 탭 콘텐츠 -->
  <div id="pickBotSection" style="display:none">
    <div class="cg-panel" style="padding:24px;max-width:720px">
      <div style="margin-bottom:16px">
        <h2 style="font-size:18px;font-weight:800;margin:0 0 4px">픽봇 — AI 카페 추천</h2>
        <p style="font-size:13px;color:var(--text-muted);margin:0">원하는 분위기나 조건을 자유롭게 입력하면 픽봇이 맞는 카페를 찾아드려요.</p>
      </div>
      <div id="chatMessages"
           style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px;
                  min-height:80px;max-height:360px;overflow-y:auto"></div>
      <div style="display:flex;gap:8px">
        <input id="chatInput" type="text" class="cg-input"
               placeholder="예) 노트북 작업하기 좋고 조용한 카페 찾아줘"
               style="flex:1;font-size:14px"/>
        <button id="chatSendBtn" class="cg-btn" style="white-space:nowrap">추천받기</button>
      </div>
    </div>
  </div>

</main>

<style>
  .chat-msg { max-width:88%;padding:10px 13px;border-radius:12px;font-size:13px;line-height:1.6; }
  .chat-msg--bot   { align-self:flex-start;background:var(--surface-alt,#f3f4f6);color:var(--text);border-radius:4px 12px 12px 12px; }
  .chat-msg--user  { align-self:flex-end;background:var(--accent);color:#fff;border-radius:12px 4px 12px 12px; }
  .chat-msg--error { align-self:flex-start;background:#fef2f2;color:#b91c1c;border-radius:4px 12px 12px 12px; }
</style>

<script>
(function () {
  const tabBtn     = document.getElementById('tabPickBot');
  const mainContent    = document.getElementById('mainContent');
  const pickBotSection = document.getElementById('pickBotSection');
  const input      = document.getElementById('chatInput');
  const sendBtn    = document.getElementById('chatSendBtn');
  const messages   = document.getElementById('chatMessages');
  const sortTabs   = tabBtn.parentElement.querySelectorAll('a');

  // 픽봇 대화와 탭 상태를 브라우저 탭이 닫힐 때까지 유지 (새로고침·상세 페이지 왕복에도 복원)
  const STORAGE_KEY = 'pickbot.state';
  const state = loadState();

  function loadState() {
    try {
      const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY));
      if (saved && Array.isArray(saved.history)) return saved;
    } catch (e) { /* 저장소를 쓸 수 없으면 빈 상태로 시작 */ }
    return { active: false, history: [] };
  }

  function saveState() {
    try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) { /* 무시 */ }
  }

  function showPickBot() {
    mainContent.style.display    = 'none';
    pickBotSection.style.display = 'block';
    // 서버가 그린 정렬 탭의 선택 표시를 해제해 픽봇 탭만 선택된 상태로 보이게 함
    sortTabs.forEach(tab => {
      tab.style.background = 'none';
      tab.style.color      = 'var(--text-sub)';
    });
    tabBtn.style.background = 'var(--accent)';
    tabBtn.style.color      = '#fff';
  }

  tabBtn.addEventListener('click', () => {
    showPickBot();
    state.active = true;
    saveState();
    input.focus();
  });

  // 정렬 탭으로 이동하면 다음 로드 때 픽봇 탭을 다시 열지 않음
  sortTabs.forEach(tab => tab.addEventListener('click', () => {
    state.active = false;
    saveState();
  }));

  state.history.forEach(renderEntry);
  if (state.active) showPickBot();

  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } });

  function sendMessage() {
    const query = input.value.trim();
    if (!query) return;

    addEntry({ kind: 'user', text: query });
    input.value = '';
    sendBtn.disabled = true;

    const loadingEl = appendMsg('추천 카페를 찾는 중...', 'bot');
    // 요청을 보낸 시점부터 응답을 받을 때까지 사용자가 실제로 기다린 시간
    const startedAt = performance.now();
    const elapsedSec = () => ((performance.now() - startedAt) / 1000).toFixed(1);

    fetch('/api/pickbot/recommend', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query })
    })
    .then(r => r.ok ? r.json() : Promise.reject(r.status))
    .then(data => {
      loadingEl.remove();
      const results = (data && data.results) || [];
      if (!results.length) {
        const msg = data && data.notice === 'REGION_NOT_FOUND'
          ? '해당 지역에는 등록된 카페가 없어요.'
          : '조건에 맞는 카페를 찾지 못했어요. 다른 표현으로 다시 시도해 보세요.';
        addEntry({ kind: 'bot', text: `${msg} (${elapsedSec()}초)` });
        return;
      }
      addEntry({ kind: 'results', results, elapsed: elapsedSec() });
    })
    .catch(() => {
      loadingEl.remove();
      addEntry({ kind: 'error', text: `일시적인 오류가 발생했어요. 잠시 후 다시 시도해 주세요. (${elapsedSec()}초)` });
    })
    .finally(() => { sendBtn.disabled = false; });
  }

  // 대화 한 건을 화면에 그리고 저장
  function addEntry(entry) {
    state.history.push(entry);
    saveState();
    renderEntry(entry);
  }

  function renderEntry(entry) {
    if (entry.kind === 'results') renderResults(entry.results, entry.elapsed);
    else appendMsg(entry.text, entry.kind);
  }

  function renderResults(results, elapsed) {
    const html = results.map(c => `
      <div style="display:flex;gap:12px;align-items:flex-start;margin-bottom:8px">
        ${c.mainPhoto
          ? `<a href="/cafes/${esc(c.cafeId)}" style="flex-shrink:0">
               <img src="${esc(c.mainPhoto)}" alt="${esc(c.cafeName)}"
                    style="width:80px;height:80px;object-fit:cover;border-radius:8px;display:block"/>
             </a>`
          : `<div style="flex-shrink:0;width:80px;height:80px;border-radius:8px;
                         background:var(--surface-alt,#f3f4f6);display:flex;align-items:center;
                         justify-content:center;font-size:24px">☕</div>`}
        <div style="min-width:0">
          <a href="/cafes/${esc(c.cafeId)}"
             style="font-weight:700;color:var(--accent);text-decoration:none;font-size:14px">${esc(c.cafeName)}</a>
          <p style="margin:2px 0 0;font-size:12px;color:var(--text-muted)">${esc(c.address || '')}</p>
          ${c.snippet ? `<p style="margin:4px 0 0;font-size:12px;color:var(--text);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">"${esc(c.snippet)}"</p>` : ''}
        </div>
      </div>
    `).join('<hr style="border:none;border-top:1px solid var(--border);margin:6px 0">');
    appendHtml(`<p style="margin:0 0 8px;font-size:13px;font-weight:600">추천 카페 ${results.length}곳을 찾았어요! <span style="font-weight:400;color:var(--text-muted)">(${esc(elapsed)}초)</span></p>${html}`, 'bot');
  }

  function appendMsg(text, type) {
    const el = document.createElement('div');
    el.className = `chat-msg chat-msg--${type}`;
    el.textContent = text;
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
    return el;
  }

  function appendHtml(html, type) {
    const el = document.createElement('div');
    el.className = `chat-msg chat-msg--${type}`;
    el.innerHTML = html;
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
    return el;
  }

  function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, c =>
      ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  }
})();
</script>

{{>layout/footer}}
