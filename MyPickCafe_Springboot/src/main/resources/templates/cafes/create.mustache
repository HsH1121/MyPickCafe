{{>layout/header}}

<div class="cg-topbar">
  <div class="cg-container cg-topbar__inner">
    <span class="cg-logo">MyPickCafe</span>
    <nav class="cg-breadcrumb">
      <a href="/">홈</a>
      <span>›</span>
      <span class="em">카페 등록</span>
    </nav>
  </div>
</div>

<main class="cg-container" style="padding:32px 0 64px">
  <div style="max-width:800px;margin:0 auto">

    <div style="margin-bottom:28px">
      <p class="cg-eyebrow">카페 등록</p>
      <h1 style="font-size:26px;font-weight:900;letter-spacing:-.5px">새 카페 등록하기</h1>
      <p style="font-size:14px;color:var(--text-sub);margin-top:6px">
        등록 후 관리자 승인을 거쳐 사이트에 노출됩니다.
      </p>
    </div>

    {{#errorMsg}}
      <div class="cg-alert cg-alert--danger" style="margin-bottom:20px">{{errorMsg}}</div>
    {{/errorMsg}}

    <form id="cafeCreateForm" method="post" action="/cafes/create"
          enctype="multipart/form-data" class="space-y">

      <!-- Step 1: 기본 정보 -->
      <div class="cg-panel">
        <div class="cg-panel__head">
          <div><p class="cg-eyebrow">Step 1</p><h2 class="cg-panel__title">기본 정보</h2></div>
        </div>
        <div class="cg-panel__body">
          <div class="cg-grid2">
            <div class="field">
              <div class="field__label">카페명 <span class="req">*</span></div>
              <input class="cg-input" name="name" maxlength="10" placeholder="최대 10자" required/>
            </div>
            <div class="field">
              <div class="field__label">카테고리 <span class="req">*</span></div>
              <select class="cg-input" name="code" required>
                <option value="">선택</option>
                <option value="CAFE">카페</option>
                <option value="DESSERT">디저트</option>
                <option value="BAR">바·카페</option>
                <option value="ROASTERY">로스터리</option>
              </select>
            </div>
            <div class="field">
              <div class="field__label">연락처 <span class="req">*</span></div>
              <input class="cg-input" name="number" maxlength="13" placeholder="02-1234-5678" required/>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: 주소 / 위치 -->
      <div class="cg-panel">
        <div class="cg-panel__head">
          <div><p class="cg-eyebrow">Step 2</p><h2 class="cg-panel__title">주소 · 위치</h2></div>
        </div>
        <div class="cg-panel__body space-y">
          <div class="grid-addr">
            <div class="addr-left">
              <div class="field">
                <div class="field__label">주소 <span class="req">*</span></div>
                <input class="cg-input" name="address" id="addressInput" maxlength="60"
                       placeholder="도로명 주소" required/>
              </div>
            </div>
            <div class="addr-right">
              <button type="button" id="btnFindAddr" class="cg-btn w100">주소 찾기</button>
            </div>
          </div>
          <div class="cg-grid2">
            <div class="field">
              <div class="field__label">위도 (lat) <span class="req">*</span></div>
              <input class="cg-input" name="lat" id="latInput" readonly placeholder="주소 찾기로 자동 입력" required/>
            </div>
            <div class="field">
              <div class="field__label">경도 (lon) <span class="req">*</span></div>
              <input class="cg-input" name="lon" id="lonInput" readonly placeholder="주소 찾기로 자동 입력" required/>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3: 카페 소개 -->
      <div class="cg-panel">
        <div class="cg-panel__head">
          <div><p class="cg-eyebrow">Step 3</p><h2 class="cg-panel__title">카페 소개</h2></div>
        </div>
        <div class="cg-panel__body space-y">
          <div class="cg-grid2">
            <div class="field">
              <div class="field__label">오픈 시간</div>
              <input class="cg-input" type="time" name="openTime"/>
            </div>
            <div class="field">
              <div class="field__label">마감 시간</div>
              <input class="cg-input" type="time" name="closeTime"/>
            </div>
            <div class="field">
              <div class="field__label">휴무일</div>
              <input class="cg-input" name="holiday" maxlength="7" placeholder="예: 월요일"/>
            </div>
            <div class="field">
              <div class="field__label">공지사항</div>
              <input class="cg-input" name="notice" maxlength="20" placeholder="최대 20자"/>
            </div>
          </div>
          <div class="field">
            <div class="field__label">카페 소개</div>
            <textarea class="cg-input" name="info" maxlength="500" rows="4"
                      placeholder="카페를 소개해주세요. (최대 500자)"></textarea>
          </div>
        </div>
      </div>

      <!-- Step 4: 카페 사진 -->
      <div class="cg-panel">
        <div class="cg-panel__head">
          <div><p class="cg-eyebrow">Step 4</p><h2 class="cg-panel__title">카페 사진</h2></div>
        </div>
        <div class="cg-panel__body">
          <div class="field">
            <div class="field__label">사진 (최대 5장, 첫 번째 사진이 대표 사진)</div>
            <div id="photoDropzone" class="create-dropzone">
              <input type="file" name="cafePhotoFiles" id="photoInput"
                     accept="image/*" multiple style="display:none"/>
              <div class="create-dropzone__inner" onclick="document.getElementById('photoInput').click()">
                <div style="font-size:32px">📷</div>
                <p style="margin:8px 0 4px;font-weight:600">클릭하거나 드래그하여 사진 업로드</p>
                <p style="font-size:13px;color:var(--text-sub)">JPG, PNG · 최대 5장</p>
              </div>
            </div>
            <div id="photoPreviewList" class="photo-preview-list"></div>
          </div>
        </div>
      </div>

      <!-- Step 5: 사업자 등록증 -->
      <div class="cg-panel">
        <div class="cg-panel__head">
          <div><p class="cg-eyebrow">Step 5</p><h2 class="cg-panel__title">사업자 등록증 <span class="req">*</span></h2></div>
        </div>
        <div class="cg-panel__body">
          <div class="field">
            <div class="field__label">사업자등록증 첨부</div>
            <div class="uploader">
              <div class="thumb" id="bizThumb"></div>
              <span id="bizLabel">사업자등록증 등 서류 첨부</span>
              <input type="file" name="bizDocFile" id="bizDocInput" class="file"
                     accept=".pdf,image/*" required/>
            </div>
            <p class="hint">PDF / JPG 허용 · 승인 후 삭제됩니다</p>
          </div>
        </div>
      </div>

      <div class="cg-actions end">
        <a href="/" class="cg-btn-outline">취소</a>
        <button type="submit" class="cg-btn">등록 신청</button>
      </div>
    </form>

  </div>
</main>

<style>
.create-dropzone {
  border: 2px dashed var(--border);
  border-radius: 10px;
  padding: 32px;
  text-align: center;
  cursor: pointer;
  transition: border-color .2s;
}
.create-dropzone:hover, .create-dropzone.drag-over { border-color: var(--accent); }
.photo-preview-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 12px;
}
.photo-preview-item {
  position: relative;
  width: 100px;
  height: 100px;
}
.photo-preview-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8px;
  border: 2px solid var(--border);
}
.photo-preview-item:first-child img { border-color: var(--accent); }
.photo-preview-item .remove-btn {
  position: absolute;
  top: -6px;
  right: -6px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  border: none;
  font-size: 12px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.photo-preview-item .main-badge {
  position: absolute;
  bottom: 4px;
  left: 4px;
  background: var(--accent);
  color: #fff;
  font-size: 10px;
  padding: 2px 5px;
  border-radius: 4px;
}
</style>

<script>
(function () {
  const input       = document.getElementById('photoInput');
  const dropzone    = document.getElementById('photoDropzone');
  const previewList = document.getElementById('photoPreviewList');
  const MAX_PHOTOS  = 5;
  let fileList      = [];

  function renderPreviews() {
    previewList.innerHTML = '';
    fileList.forEach((file, i) => {
      const url  = URL.createObjectURL(file);
      const item = document.createElement('div');
      item.className = 'photo-preview-item';
      item.innerHTML = `
        <img src="${url}" alt="사진 ${i+1}"/>
        ${i === 0 ? '<span class="main-badge">대표</span>' : ''}
        <button type="button" class="remove-btn" data-index="${i}">×</button>
      `;
      previewList.appendChild(item);
    });

    // 새 input 생성해서 실제 파일 세트 반영
    const oldInput = document.getElementById('photoInput');
    const dt = new DataTransfer();
    fileList.forEach(f => dt.items.add(f));
    oldInput.files = dt.files;
  }

  previewList.addEventListener('click', e => {
    const btn = e.target.closest('.remove-btn');
    if (!btn) return;
    fileList.splice(Number(btn.dataset.index), 1);
    renderPreviews();
  });

  function addFiles(newFiles) {
    for (const f of newFiles) {
      if (fileList.length >= MAX_PHOTOS) break;
      fileList.push(f);
    }
    renderPreviews();
  }

  input.addEventListener('change', () => addFiles(input.files));

  dropzone.addEventListener('dragover',  e => { e.preventDefault(); dropzone.classList.add('drag-over'); });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('drag-over'));
  dropzone.addEventListener('drop', e => {
    e.preventDefault();
    dropzone.classList.remove('drag-over');
    addFiles(e.dataTransfer.files);
  });

  // 사업자 증빙 미리보기
  document.getElementById('bizDocInput').addEventListener('change', function () {
    const label = document.getElementById('bizLabel');
    label.textContent = this.files[0] ? this.files[0].name : '사업자등록증 등 서류 첨부';
  });

  // 주소 찾기 (카카오 우편번호)
  document.getElementById('btnFindAddr').addEventListener('click', function () {
    if (typeof daum === 'undefined') { alert('주소 검색 서비스를 불러오는 중입니다.'); return; }
    new daum.Postcode({
      oncomplete: function (data) {
        const addr = data.roadAddress || data.jibunAddress;
        document.getElementById('addressInput').value = addr;

        // 카카오 지오코딩 → lat/lon
        const geocoder = new kakao.maps.services.Geocoder();
        geocoder.addressSearch(addr, function (result, status) {
          if (status === kakao.maps.services.Status.OK) {
            document.getElementById('latInput').value = result[0].y;
            document.getElementById('lonInput').value = result[0].x;
          }
        });
      }
    }).open();
  });
})();
</script>

{{>layout/footer}}
